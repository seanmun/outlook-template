# Copy to .env.local. Leave Clerk or Supabase blank to run the local demo mode.

# --- Clerk (authentication) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# --- Supabase (Postgres + Storage) ---
# Use the anon/publishable key. Requests run as the signed-in Clerk user under RLS.
# Do NOT put a service-role key anywhere in this app.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Anthropic (server-side only) ---
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-opus-5-5.
ANTHROPIC_MODEL=
# Server-side refusal fallback is on for supported models; set to "off" to disable.
ANTHROPIC_FALLBACKS=

# --- Demo mode only ---
# Allow AI calls without sign-in when Clerk/Supabase are not configured. Local development only.
DEMO_ALLOW_AI=false

# --- Exporters ---
# Enables the UNVERIFIED Outlook for Mac .emltpl exporter. See docs/EXPORT.md.
EXPORT_EMLTPL_EXPERIMENTAL=false
